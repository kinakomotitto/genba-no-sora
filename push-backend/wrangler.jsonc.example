{
  // Copy to wrangler.jsonc after creating your OWN D1 database.
  // DO NOT deploy this template with the placeholder database ID.
  "name": "genba-no-sora-noon-push",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-09",
  "triggers": {
    // Enable ONLY after D1 and VAPID secrets are configured and
    // confirmed by a successful opt-in iPhone push test.
    // Every 15 minutes in UTC; the Worker matches per-user chosen Japan times.
    // "crons": ["*/15 * * * *"]
    "crons": []
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genba-no-sora-push-private",
      "database_id": "REPLACE_WITH_YOUR_OWN_D1_DATABASE_UUID"
    }
  ]
}
